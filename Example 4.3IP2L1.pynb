{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyP3Pz0lQapWZUVLbx4fm/8O"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"id":"__J3g6nelA1X","executionInfo":{"status":"ok","timestamp":1770051416700,"user_tz":-330,"elapsed":37134,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}}},"outputs":[],"source":["# import libraries\n","#!pip install numfracpy\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import tensorflow as tf\n","import tensorflow_probability as tfp\n","import time\n","\n","# set double precision\n","#from numfracpy import Mittag_Leffler_two\n","from scipy.special import gamma\n","tf.keras.backend.set_floatx('float64')\n","tf_dtype = tf.float64"]},{"cell_type":"code","execution_count":2,"metadata":{"id":"WiojI_MqlC_T","executionInfo":{"status":"ok","timestamp":1770051417157,"user_tz":-330,"elapsed":443,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}}},"outputs":[],"source":["# @title\n","def tensor(x):\n","    return tf.convert_to_tensor(x, dtype=tf_dtype)\n","\n","def visualize_solution(model, solution, x_data=None, u_data=None, with_param=None):\n","    # Solution visualization\n","    x_plot = tf.linspace(tensor([0.0]), tensor([1.0]), 300)\n","    if with_param is not None:\n","        p_plot = with_param * tf.ones(shape=(300, 1), dtype=tf_dtype)\n","        x_plot = tf.concat([x_plot, p_plot], axis=1)\n","\n","    u_plot_ex = solution(x_plot)\n","    u_plot_nn = nn.predict(x_plot)[:, 0]\n","\n","    plt.plot(x_plot[:, 0:1], u_plot_ex, c='b')\n","    plt.plot(x_plot[:, 0:1], u_plot_nn, '--', c='r')\n","\n","    if x_data is not None:\n","        u_data_nn = nn.call(x_data)[:, 0]\n","        plt.scatter(x_data, u_data, c='b')\n","        plt.scatter(x_data, u_data_nn, c='r')\n","\n","    if with_param is None:\n","        plt.title(\"Solution\")\n","    else:\n","        plt.title(\"Solution with p = \"+str(with_param))\n","    plt.xlabel(\"x\")\n","    plt.legend([\"Exact solution\", \"Network solution\"], bbox_to_anchor=(1.05, 1.0), loc='upper left')\n","    plt.show()\n","\n","\n","def visualize_error(model, solution, with_param=None):\n","    # Error visualization\n","    x_plot = tf.linspace(tensor([0.0]), tensor([1.0]), 300)\n","    if with_param is not None:\n","        p_plot = with_param * tf.ones(shape=(300, 1), dtype=tf_dtype)\n","        x_plot = tf.concat([x_plot, p_plot], axis=1)\n","\n","    u_plot_ex = solution(x_plot)\n","    u_plot_nn = nn.predict(x_plot)[:, 0]\n","\n","    error = np.abs(np.squeeze(u_plot_ex)-u_plot_nn)\n","    plt.plot(x_plot[:, 0:1], error)\n","\n","    if with_param is None:\n","        plt.title(\"Error (average error {:.2e})\".format(np.mean(error)))\n","    else:\n","        plt.title(\"Error with p = \"+str(with_param))\n","\n","    plt.legend([\"Absolute value of the error\"], bbox_to_anchor=(1.05, 1.0), loc='upper left')\n","    plt.yscale(\"log\")\n","    plt.xlabel(\"x\")\n","    plt.ylabel(\"$|u-u^{NN}|$\")\n","    plt.show()\n","\n","def visualize_parametric_sol(model, solution):\n","    N = 100\n","    n_levels = 30\n","\n","    x = np.linspace(0, 1, N)\n","    p = np.linspace(-1, 1, N)\n","\n","    x, p = np.meshgrid(x, p)\n","    x_and_p = np.concatenate([x.reshape(N*N, 1), p.reshape(N*N, 1)], axis=1)\n","    x_and_p = tensor(x_and_p)\n","\n","    # figure, axes = plt.subplots()\n","    fig = plt.figure()\n","    ax1 = fig.add_subplot(1,3,1)\n","    ax2 = fig.add_subplot(1,3,2)\n","    ax3 = fig.add_subplot(1,3,3)\n","\n","    net_sol = model.call(x_and_p)[:, 0:1]\n","    plot_sol = net_sol.numpy().reshape(N, N)\n","\n","    exact_sol = solution(x_and_p).numpy().reshape(N,N)\n","\n","    im1 = ax1.contourf(x, p, plot_sol, levels=n_levels)\n","    ax1.contour(x, p, plot_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax1.set_xlabel(\"x\")\n","    ax1.set_ylabel(\"p\")\n","    ax1.set_title(\"PINN\")\n","\n","    im2 = ax2.contourf(x, p, exact_sol, levels=n_levels)\n","    ax2.contour(x, p, exact_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax2.set_xlabel(\"x\")\n","    ax2.set_ylabel(\"p\")\n","    ax2.set_title(\"Exact\")\n","\n","    im3 = ax3.contourf(x, p, np.abs(plot_sol - exact_sol), levels=n_levels)\n","    ax3.contour(x, p, np.abs(plot_sol - exact_sol), levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax3.set_xlabel(\"x\")\n","    ax3.set_ylabel(\"p\")\n","    ax3.set_title(\"Error\")\n","\n","    fig.set_figwidth(15)\n","    fig.set_figheight(6)\n","    fig.colorbar(im1)\n","    fig.colorbar(im2)\n","    fig.colorbar(im3)\n","    fig.tight_layout(pad = 1)\n","    plt.show()\n","\n","\n","\n","def visualize_1d_contour(model, solution):\n","    N = 100\n","    n_levels = 30\n","\n","    x = np.linspace(0, 1, N)\n","    y = np.linspace(0, 1, N)\n","\n","    x, y = np.meshgrid(x, y)\n","    xy = np.concatenate([x.reshape(N*N, 1), y.reshape(N*N, 1)], axis=1)\n","    xy = tensor(xy)\n","\n","    # figure, axes = plt.subplots()\n","    fig = plt.figure()\n","    ax1 = fig.add_subplot(1,3,1)\n","    ax2 = fig.add_subplot(1,3,2)\n","    ax3 = fig.add_subplot(1,3,3)\n","\n","    net_sol = model.predict(xy)[:, 0:1]\n","    plot_sol = net_sol.numpy().reshape(N, N)\n","\n","    exact_sol = solution(xy).numpy().reshape(N,N)\n","\n","    im1 = ax1.contourf(x, y, plot_sol, levels=n_levels)\n","    ax1.contour(x, y, plot_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax1.set_xlabel(\"x\")\n","    ax1.set_ylabel(\"t\")\n","    ax1.set_title(\"PINN\")\n","\n","    im2 = ax2.contourf(x, y, exact_sol, levels=n_levels)\n","    ax2.contour(x, y, exact_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax2.set_xlabel(\"x\")\n","    ax2.set_ylabel(\"t\")\n","    ax2.set_title(\"Exact\")\n","\n","    im3 = ax3.contourf(x, y, np.abs(plot_sol - exact_sol), levels=n_levels)\n","    ax3.contour(x, y, np.abs(plot_sol - exact_sol), levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax3.set_xlabel(\"x\")\n","    ax3.set_ylabel(\"y\")\n","    ax3.set_title(\"Error\")\n","\n","    fig.set_figwidth(11)\n","    fig.set_figheight(3)\n","    fig.colorbar(im1)\n","    fig.colorbar(im2)\n","    fig.colorbar(im3)\n","    fig.tight_layout(pad = 1)\n","    plt.savefig('1DEFKGcontour.eps', dpi=1200)\n","    plt.show()\n","\n","def visualize_1d_time_sol(model, solution):\n","    N = 100\n","\n","    x = np.linspace(0, 1, N)\n","    y = np.linspace(0, 1, N)\n","\n","    x, y = np.meshgrid(x, y)\n","    xy = np.concatenate([x.reshape(N*N, 1), y.reshape(N*N, 1)], axis=1)\n","    xy = tensor(xy)\n","\n","\n","    net_sol = model.predict(xy)[:, 0:1]\n","    plot_sol = net_sol.numpy().reshape(N, N)\n","\n","    exact_sol = solution(xy).numpy().reshape(N,N)\n","\n","    fig1 = plt.figure(figsize=(12,6))\n","\n","\n","    ax1 = fig1.add_subplot(1, 2, 1, projection='3d')\n","    surf1 = ax1.plot_surface(x, y, plot_sol, cmap='viridis', edgecolor='none')\n","    ax1.set_xlabel('x')\n","    ax1.set_ylabel('t')\n","    ax1.set_zlabel('Solution', labelpad=-0.001)\n","    ax1.set_title('PINNs')\n","    #fig1.colorbar(surf1, ax=ax1, shrink=0.5, aspect=5)\n","\n","    ax2 = fig1.add_subplot(1, 2, 2, projection='3d')\n","    surf2 = ax2.plot_surface(x, y, exact_sol, cmap='viridis', edgecolor='none')\n","    ax2.set_xlabel('x')\n","    ax2.set_ylabel('t')\n","    ax2.set_zlabel('Solution', labelpad=-0.001)\n","    ax2.set_title('Exact Solution')\n","    plt.savefig('1DEFKGexactPINNS.eps', dpi=1200)\n","    #fig1.colorbar(surf2, ax=ax2, shrink=0.5, aspect=5)\n","    plt.show()\n","\n","\n","\n","    plt.pause(0.01)\n","\n","    fig2 = plt.figure()\n","    fig2.tight_layout(pad=-4.0)\n","    ax3 = fig2.add_subplot(1, 1, 1, projection='3d')\n","    surf3 = ax3.plot_surface(x, y, np.abs(plot_sol - exact_sol), cmap='viridis', edgecolor='none')\n","    ax3.set_xlabel('x')\n","    ax3.set_ylabel('t')\n","    ax3.set_zlabel('Error',labelpad=6.0)\n","    ax3.set_title('Absolute Error')\n","    plt.savefig('1DEFKGerror.eps', dpi=1200)\n","    #fig2.colorbar(surf3, ax=ax3, shrink=0.5, aspect=5)\n","\n","    plt.show()\n","\n","def visualize_contour_sol(model,sol,t):\n","    N = 100\n","    n_levels = 30\n","\n","    x = np.linspace(0, 1, N)\n","    y = np.linspace(0, 1, N)\n","\n","    x, y = np.meshgrid(x, y)\n","    xy = np.concatenate([x.reshape(N*N, 1), y.reshape(N*N, 1), t*np.ones((N*N, 1))], axis=1)\n","    xy = tensor(xy)\n","    # figure, axes = plt.subplots()\n","    fig = plt.figure()\n","    ax1 = fig.add_subplot(1,3,1)\n","    ax2 = fig.add_subplot(1,3,2)\n","    ax3 = fig.add_subplot(1,3,3)\n","\n","    net_sol = model.predict(xy)[:, 0:1]\n","    plot_sol = net_sol.numpy().reshape(N, N)\n","\n","    exact_sol = solution(xy).numpy().reshape(N,N)\n","\n","    im1 = ax1.contourf(x, y, plot_sol, levels=n_levels)\n","    ax1.contour(x, y, plot_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax1.set_xlabel(\"x\")\n","    ax1.set_ylabel(\"t\")\n","    ax1.set_title(\"PINN\")\n","\n","    im2 = ax2.contourf(x, y, exact_sol, levels=n_levels)\n","    ax2.contour(x, y, exact_sol, levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax2.set_xlabel(\"x\")\n","    ax2.set_ylabel(\"t\")\n","    ax2.set_title(\"Exact\")\n","\n","    im3 = ax3.contourf(x, y, np.abs(plot_sol - exact_sol), levels=n_levels)\n","    ax3.contour(x, y, np.abs(plot_sol - exact_sol), levels=n_levels, colors=\"k\", linewidths=0.3)\n","    ax3.set_xlabel(\"x\")\n","    ax3.set_ylabel(\"y\")\n","    ax3.set_title(\"Error\")\n","\n","    fig.set_figwidth(11)\n","    fig.set_figheight(3)\n","    fig.colorbar(im1)\n","    fig.colorbar(im2)\n","    fig.colorbar(im3)\n","    fig.tight_layout(pad = 1)\n","    plt.show()\n","\n","def visualize_2d_time_sol(model,sol, t):\n","    N = 100\n","\n","    x = np.linspace(0, 1, N)\n","    y = np.linspace(0, 1, N)\n","\n","    x, y = np.meshgrid(x, y)\n","    xy = np.concatenate([x.reshape(N*N, 1), y.reshape(N*N, 1), t*np.ones((N*N, 1))], axis=1)\n","    xy = tensor(xy)\n","\n","\n","    net_sol = model.predict(xy)[:, 0:1]\n","    plot_sol = net_sol.numpy().reshape(N, N)\n","    exact_sol = sol(xy).numpy().reshape(N,N)\n","    fig1 = plt.figure(figsize=(12,6))\n","\n","\n","    ax1 = fig1.add_subplot(1, 2, 1, projection='3d')\n","    surf1 = ax1.plot_surface(x, y, plot_sol, cmap='viridis', edgecolor='none')\n","    ax1.set_xlabel('x')\n","    ax1.set_ylabel('t')\n","    ax1.set_zlabel('Solution', labelpad=-0.001)\n","    ax1.set_title('PINNs')\n","    #fig1.colorbar(surf1, ax=ax1, shrink=0.5, aspect=5)\n","\n","    ax2 = fig1.add_subplot(1, 2, 2, projection='3d')\n","    surf2 = ax2.plot_surface(x, y, exact_sol, cmap='viridis', edgecolor='none')\n","    ax2.set_xlabel('x')\n","    ax2.set_ylabel('t')\n","    ax2.set_zlabel('Solution', labelpad=-0.001)\n","    ax2.set_title('Exact Solution')\n","    plt.savefig('1DEFKGexactPINNS.eps', dpi=1200)\n","    #fig1.colorbar(surf2, ax=ax2, shrink=0.5, aspect=5)\n","    plt.show()\n","\n","\n","\n","    plt.pause(0.01)\n","\n","    fig2 = plt.figure()\n","    fig2.tight_layout(pad=-4.0)\n","    ax3 = fig2.add_subplot(1, 1, 1, projection='3d')\n","    surf3 = ax3.plot_surface(x, y, np.abs(plot_sol - exact_sol), cmap='viridis', edgecolor='none')\n","    ax3.set_xlabel('x')\n","    ax3.set_ylabel('t')\n","    ax3.set_zlabel('Error',labelpad=6.0)\n","    ax3.set_title('Absolute Error')\n","    plt.savefig('1DEFKGerror.eps', dpi=1200)\n","\n","\n","\n","def parameter_graph(model,ymin,ymax, mod_n,G):\n","    n = len(model.G_log)\n","    iteration = np.arange(1, n + 1)\n","    mod_indices = np.where(iteration % mod_n == 0)[0]\n","    mod_iteration = iteration[mod_indices]\n","    mod_G_log = np.array(model.G_log)[mod_indices]\n","    Actual_G=G*np.ones(len(mod_indices))\n","    mod_G_log=5*(10/(10+tf.exp(-mod_G_log)))\n","    plt.figure(figsize=(6, 4))\n","    plt.plot(mod_iteration, mod_G_log,label='Parameter esimation' r' $\\gamma$ using PINNs')\n","    plt.plot(mod_iteration, Actual_G, linestyle='--',label='Exact value of ' r'$\\gamma$')\n","    plt.xlabel('Iteration')\n","    plt.ylabel(r' $\\gamma$ Value')\n","    plt.title('Iteration vs.' r' $\\gamma$')\n","    plt.legend()\n","    plt.ylim(ymin,ymax)\n","    plt.savefig('2DFPINNSgammaL1.eps', dpi=1200)\n","    #plt.savefig('2DEFKsplitparameter.pdf', dpi=1200)\n","    plt.show()\n","\n","\n","def Aparameter_graph(model,ymin,ymax, mod_n,A):\n","    n = len(model.alpha_log)\n","    iteration = np.arange(1, n + 1)\n","    mod_indices = np.where(iteration % mod_n == 0)[0]\n","    mod_iteration = iteration[mod_indices]\n","    mod_alpha_log = np.array(model.alpha_log)[mod_indices]\n","    mod_alpha_log =10/(10+tf.exp(-mod_alpha_log))\n","    Actual_alpha=A*np.ones(len(mod_indices))\n","    plt.figure(figsize=(6, 4))\n","    plt.plot(mod_iteration, mod_alpha_log,label='Parameter esimation' r' $\\alpha$ using PINNs')\n","    plt.plot(mod_iteration, Actual_alpha, linestyle='--',label='Exact value of ' r'$\\alpha$')\n","    plt.xlabel('Iteration')\n","    plt.ylabel(r' $\\alpha$ Value')\n","    plt.title('Iteration vs.' r' $\\alpha$')\n","    plt.legend()\n","    plt.ylim(ymin,ymax)\n","    plt.savefig('2DFPINNSalphaL1.eps', dpi=1200)\n","    #plt.savefig('2DEFKsplitparameter.pdf', dpi=1200)\n","    plt.show()\n","\n","def build_nn(nn, input_shape):\n","    for layer in nn.layers_list:\n","        layer.build(input_shape)\n","        input_shape = layer.compute_output_shape(input_shape)\n","    np.built = True\n","\n","def train_with_first_order(model, loss_f, x, y, n_epochs, shuffle, learning_rate, cb_list=[], validation_data=None, verbose=0, validation_split=0.0, bsize=None):\n","    optimizer = tf.optimizers.Adam(learning_rate, epsilon=1e-13)\n","    # model.build((None, model.input_dim))\n","    build_nn(model, (None, model.input_dim))\n","    model.compile(optimizer=optimizer, loss=loss_f)\n","    if bsize is None:\n","        bsize = x.shape[0]\n","    model.fit(x, y, batch_size=bsize, epochs=n_epochs, shuffle=shuffle, verbose=verbose, callbacks=cb_list, validation_split=validation_split)\n","\n","# Function shared by https://gist.github.com/piyueh/712ec7d4540489aad2dcfb80f9a54993\n","def function_factory(model, loss, train_x, train_y, print_each_n_epochs):\n","    \"\"\"A factory to create a function required by tfp.optimizer.bfgs_minimize.\n","    Args:\n","        model [in]: an instance of `tf.keras.Model` or its subclasses.\n","        loss [in]: a function with signature loss_value = loss(pred_y, true_y).\n","        train_x [in]: the input part of training data.\n","        train_y [in]: the output part of training data.\n","    Returns:\n","        A function that has a signature of:\n","            loss_value, gradients = f(model_parameters).\n","    \"\"\"\n","    model.G_log = []\n","    model.alpha_log = []\n","    # obtain the shapes of all trainable parameters in the model\n","    shapes = tf.shape_n(model.trainable_variables)\n","    n_tensors = len(shapes)\n","\n","    # we'll use tf.dynamic_stitch and tf.dynamic_partition later, so we need to\n","    # prepare required information first\n","    count = 0\n","    idx = [] # stitch indices\n","    part = [] # partition indices\n","\n","    for i, shape in enumerate(shapes):\n","        n = np.prod(shape)\n","        idx.append(tf.reshape(tf.range(count, count+n, dtype=tf.int32), shape))\n","        part.extend([i]*n)\n","        count += n\n","\n","    part = tf.constant(part)\n","\n","    @tf.function(experimental_relax_shapes=True)\n","    def assign_new_model_parameters(params_1d):\n","        \"\"\"A function updating the model's parameters with a 1D tf.Tensor.\n","        Args:\n","            params_1d [in]: a 1D tf.Tensor representing the model's trainable parameters.\n","        \"\"\"\n","\n","        params = tf.dynamic_partition(params_1d, part, n_tensors)\n","        for i, (shape, param) in enumerate(zip(shapes, params)):\n","            model.trainable_variables[i].assign(tf.reshape(param, shape))\n","\n","    # now create a function that will be returned by this factory\n","    @tf.function(experimental_relax_shapes=True)\n","    def f(params_1d):\n","        \"\"\"A function that can be used by tfp.optimizer.bfgs_minimize.\n","        This function is created by function_factory.\n","        Args:\n","        params_1d [in]: a 1D tf.Tensor.\n","        Returns:\n","            A scalar loss and the gradients w.r.t. the `params_1d`.\n","        \"\"\"\n","\n","        # use GradientTape so that we can calculate the gradient of loss w.r.t. parameters\n","        with tf.GradientTape() as tape:\n","            # update the parameters in the model and calculate the loss\n","            assign_new_model_parameters(params_1d)\n","            loss_value = loss(train_y,model(train_x, training=True))\n","            loss_value += model.reg_coefficient*tf.norm(params_1d)\n","\n","        if loss_value<model.best_loss:\n","            model.best_w.assign(params_1d)\n","            model.best_loss.assign(loss_value)\n","\n","\n","        # log data of parameter\n","        tf.py_function(lambda: model.G_log.append(model.G.numpy().tolist()), [], [])\n","\n","        # log data of parameter\n","        tf.py_function(lambda: model.alpha_log.append(model.alpha.numpy().tolist()), [], [])\n","\n","        # calculate gradients and convert to 1D tf.Tensor\n","        grads = tape.gradient(loss_value, model.trainable_variables)\n","        grads = tf.dynamic_stitch(idx, grads)\n","\n","        # print out iteration & loss\n","        f.iter.assign_add(1)\n","        if f.iter%print_each_n_epochs == 0:\n","            tf.print(\"Iteration:\", f.iter, \" --> Loss function:\", model.best_loss)\n","\n","        return loss_value, grads\n","\n","    # store these information as members so we can use them outside the scope\n","    f.iter = tf.Variable(0)\n","    f.idx = idx\n","    f.part = part\n","    f.shapes = shapes\n","    f.assign_new_model_parameters = assign_new_model_parameters\n","\n","    return f\n","\n","def train_w_bfgs(model,loss,train_data,train_labels,n_epochs,bfgs=True,print_each_n_epochs=100,use_true_hessian=False, tolerance=1e-7):\n","\n","    if not hasattr(model, 'best_val_loss'):\n","        model.best_loss = tf.Variable(tensor(np.inf),trainable=False,dtype=tf_dtype)\n","        model.best_val_loss = tf.Variable(tensor(np.inf),trainable=False,dtype=tf_dtype)\n","        model.best_w = tf.Variable(tensor([0.]),trainable=False,validate_shape=False,shape=(None,),dtype=tf_dtype)\n","\n","    func = function_factory(model, loss, train_data, tf.expand_dims(tf.squeeze(train_labels),1), print_each_n_epochs)\n","    init_params = tf.dynamic_stitch(func.idx, model.trainable_variables)\n","\n","    if bfgs:\n","        results = tfp.optimizer.bfgs_minimize(\n","            value_and_gradients_function=func, initial_position=init_params, max_iterations=tf.convert_to_tensor(n_epochs,dtype=tf.int32),\n","            max_line_search_iterations=20, parallel_iterations=n_epochs, tolerance=tolerance, initial_inverse_hessian_estimate=None)\n","    else:\n","        results = tfp.optimizer.lbfgs_minimize(\n","            value_and_gradients_function=func, initial_position=init_params, max_iterations=tf.convert_to_tensor(n_epochs,dtype=tf.int32),\n","            max_line_search_iterations=20, parallel_iterations=n_epochs, tolerance=tolerance)\n","\n","    func.assign_new_model_parameters(model.best_w)\n","    tf.print(\"Training finished with Loss =\",model.best_loss.read_value())\n","    return [results, func]\n","\n","\n","def define_layers(nn, input_dimension, n_layers, n_neurons, activ_fun):\n","    nn.input_dim = input_dimension\n","    nn.reg_coefficient = 1e-8\n","\n","    reg = tf.keras.regularizers.L2(nn.reg_coefficient)\n","\n","    first_layer = tf.keras.layers.Dense(input_dim = input_dimension,\n","                                        units = n_neurons,\n","                                        activation=activ_fun,\n","                                        kernel_initializer='glorot_normal', kernel_regularizer=reg, bias_regularizer=reg)\n","    layers_list = [first_layer]\n","    for _ in range(n_layers-2):\n","        ith_layer = tf.keras.layers.Dense(input_dim=n_neurons,\n","                                            units = n_neurons,\n","                                            activation=activ_fun,\n","                                            kernel_initializer='glorot_normal', kernel_regularizer=reg, bias_regularizer=reg)\n","        layers_list.append(ith_layer)\n","\n","    last_layer = tf.keras.layers.Dense(input_dim=n_neurons,\n","                                        units = 1,\n","                                        activation = None,\n","                                        kernel_initializer='glorot_normal', kernel_regularizer=reg, bias_regularizer=reg)\n","    layers_list.append(last_layer)\n","    return layers_list"]},{"cell_type":"code","execution_count":3,"metadata":{"id":"oUdrMtYplK7b","executionInfo":{"status":"ok","timestamp":1770051417266,"user_tz":-330,"elapsed":107,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}}},"outputs":[],"source":["# definition of the class managing the neural network and the loss function\n","class NeuralNetwork(tf.keras.Model):\n","    def __init__(self, input_dim, n_layers, n_neurons, activ_fun, lambdas_eq_data_dirichlet=[0.0, 0.0, 0.0]):\n","        super().__init__()\n","\n","        # For the data and bc terms in the loss function\n","        self.x_data, self.u_data = None, None\n","        self.x_dirichlet, self.u_dirichlet = None, None\n","        self.lamb_eq, self.lamb_data, self.lamb_dirichlet = lambdas_eq_data_dirichlet\n","        # Function to create the layers\n","        self.layers_list = define_layers(self, input_dim, n_layers, n_neurons, activ_fun)\n","        self.psi, self.Lifting = self.adapt_ic()\n","        self.G = tf.keras.Variable(tensor(0.05),trainable=True,dtype=tf_dtype)\n","        self.alpha = tf.keras.Variable(tensor(0.1),trainable=True,dtype=tf_dtype)\n","\n","\n","    def adapt_ic(self):\n","      def psi(xyt):\n","            t = xyt[:, 2:3]\n","            return (t)\n","      def Lifting(xyt):\n","            return 0.0\n","      return psi, Lifting\n","\n","\n","\n","    # operator used to enforce the initial conditions\n","    def enforce_ic(self, u, x):\n","        return self.psi(x) * u + self.Lifting(x)\n","\n","\n","    @tf.function\n","    def predict(self, x):\n","        u = self.layers_list[0](x)\n","        for layer in self.layers_list[1:]:\n","           u = layer(u)\n","        u=self.enforce_ic( u, x)\n","        return u\n","\n","    @tf.function\n","    def fractional_derivative(self, xt,Alpha,Gamma):\n","        tf.config.run_functions_eagerly(False)\n","        def a(alpha,l):\n","          return (l+1)**(1-alpha)  - (l)**(1-alpha)\n","\n","        def b(alpha,l):\n","          return 1/(2-alpha) *((l+1)**(2-alpha)-(l)**(2-alpha)) - 1/2 *((l+1)**(1-alpha)+(l)**(1-alpha))\n","\n","        def c(alpha, s, j):\n","          if j==1:\n","              if  s==0:\n","                  return  a(alpha,0) + b(alpha,0) +b(alpha,1)\n","              else:\n","                  return  a(alpha,1) - b(alpha,1) - b(alpha,0)\n","          if j==2:\n","              if  s==0:\n","                  return  a(alpha,0) + b(alpha,0)\n","              elif s==1:\n","                  return  a(alpha,1) + b(alpha,1) + b(alpha,2) - b(alpha,0)\n","              else:\n","                  return  a(alpha,2) - b(alpha,2) - b(alpha,1)\n","\n","          if j>=3:\n","              if  s==0:\n","                  return  a(alpha,0) + b(alpha,0)\n","              elif 1<=s and s <= j-2:\n","                  return  a(alpha,s) + b(alpha,s) - b(alpha,s-1)\n","              elif s == j-1:\n","                  return  a(alpha,j-1) + b(alpha,j-1) + b(alpha,j)- b(alpha,j-2)\n","              else:\n","                  return  a(alpha,j) - b(alpha,j) - b(alpha,j-1)\n","        t=xt[:,2:3]\n","        dt = t[1]-t[0]\n","        dt=tf.squeeze(dt)\n","        x=xt[1]\n","        tn = tf.concat([tf.reshape(tensor(0.0), (1, 1)), t], axis=0)\n","        xnp1,xnp2,tn=tf.meshgrid(x[0],x[1], tn)\n","        Xt=tensor(tf.stack([xnp1,xnp2 , tn], axis=-1))\n","        Xt= tf.squeeze(tf.squeeze(Xt, axis=1))\n","        u_t = self.predict(Xt)\n","        t=tf.squeeze(t)\n","        v=tf.squeeze(u_t)\n","        D_alpha_u = [0.0]*(self.N_t)\n","        for j in range(0, self.N_t):\n","            sum_term = sum(a(Alpha,j-s)*(v[s+1] - v[s]) for s in range(0,j+1))\n","            D_alpha_u[j] = dt**(-Alpha)*sum_term /Gamma\n","        D_alpha_u=tf.reshape(tensor(D_alpha_u), (-1, 1))\n","        return D_alpha_u\n","\n","\n","    # METHOD TO EVALUATE THE NN\n","    @tf.function\n","    def call(self, xyt):\n","        with tf.GradientTape(persistent=True) as tape:\n","            tape.watch(xyt)\n","            u = self.predict(xyt)\n","            # Calculate u_x and u_xx within the GradientTape context\n","            ux_uy = tape.gradient(u, xyt)\n","            u_xx = tape.gradient(ux_uy[:,0:1], xyt)[:, 0:1]\n","            u_yy = tape.gradient(ux_uy[:,1:2], xyt)[:, 1:2]\n","\n","        Alpha=(10/(10+tf.exp(-self.alpha)))\n","        # Use tf.py_function to execute gamma eagerly\n","        Gamma = tf.exp(tf.math.lgamma(2 - Alpha))\n","        u_alpha_list=[]\n","        # fractional derivatives computation\n","        for i in range(self.N_x*self.N_y):\n","            u_alpha=self.fractional_derivative(xyt[i*(self.N_t):(i+1)*self.N_t],Alpha,Gamma)\n","            u_alpha_list.append(u_alpha)\n","        u_alpha_x=tf.concat(u_alpha_list, axis=0)\n","        return tf.concat([u,u_xx,u_yy,u_alpha_x], axis=1)\n","\n","    # LOSSES\n","    @tf.function\n","    def mean_squared_error(self, target, prediction):\n","        return tf.reduce_mean(tf.square(prediction-target))\n","\n","    @tf.function\n","    def equation_loss(self, f, u_and_ders):\n","        u = u_and_ders[:, 0:1]\n","        u_xx = u_and_ders[:, 1:2]\n","        u_yy = u_and_ders[:, 2:3]\n","        u_alpha_x = u_and_ders[:, 3:4]\n","        v=5*(10/(10+tf.exp(-self.G)))\n","        residuals = u_alpha_x  -v*(u_xx +u_yy) - f\n","        return tf.reduce_mean(tf.square(residuals))\n","\n","    @tf.function\n","    def pinn_loss(self, f, u_and_ders):\n","        eq_term = self.equation_loss(f, u_and_ders)\n","        data_term = self.mean_squared_error(self.u_data, self.predict(self.x_data)[:, 0:1])\n","        dirichlet_term = self.mean_squared_error(self.u_dirichlet, self.predict(self.x_dirichlet)[:, 0:1])\n","        #robin_term = self.mean_squared_error(self.u_robin, self.call(self.x_robin)[:, 0:1] + self.call(self.x_robin)[:, 1:2])\n","\n","        return ( self.lamb_eq * eq_term  +self.lamb_dirichlet*dirichlet_term +self.lamb_data*data_term )"]},{"cell_type":"code","execution_count":4,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"LqabDPseojuo","outputId":"57e3490c-f048-4cb8-937f-7fd8bcec8028","executionInfo":{"status":"ok","timestamp":1770052015265,"user_tz":-330,"elapsed":597986,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}}},"outputs":[{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/keras/src/layers/core/dense.py:93: UserWarning: Do not pass an `input_shape`/`input_dim` argument to a layer. When using Sequential models, prefer using an `Input(shape)` object as the first layer in the model instead.\n","  super().__init__(activity_regularizer=activity_regularizer, **kwargs)\n","WARNING:tensorflow:Calling GradientTape.gradient on a persistent tape inside its context is significantly less efficient than calling it outside the context (it causes the gradient ops to be recorded on the tape, leading to increased CPU and memory usage). Only call GradientTape.gradient inside the context if you actually want to trace the gradient in order to compute higher order derivatives.\n"]},{"output_type":"stream","name":"stdout","text":["Iteration: 100  --> Loss function: 8.1206681333870812\n","Iteration: 200  --> Loss function: 1.3683847953939932\n","Iteration: 300  --> Loss function: 0.93602644710083738\n","Iteration: 400  --> Loss function: 0.72971041708450979\n","Iteration: 500  --> Loss function: 0.56346214232871261\n","Iteration: 600  --> Loss function: 0.15292903098598085\n","Iteration: 700  --> Loss function: 0.088557922667622663\n","Iteration: 800  --> Loss function: 0.045142414400829022\n","Iteration: 900  --> Loss function: 0.021720109515233083\n","Iteration: 1000  --> Loss function: 0.014408980101834883\n","Iteration: 1100  --> Loss function: 0.010607469467554458\n","Iteration: 1200  --> Loss function: 0.007445717927093057\n","Iteration: 1300  --> Loss function: 0.0056027948631823064\n","Iteration: 1400  --> Loss function: 0.0041106438518157522\n","Iteration: 1500  --> Loss function: 0.003507872819512634\n","Iteration: 1600  --> Loss function: 0.0021950082923101822\n","Iteration: 1700  --> Loss function: 0.0020249188721968982\n","Iteration: 1800  --> Loss function: 0.0016816369484306537\n","Iteration: 1900  --> Loss function: 0.0015461983398777713\n","Iteration: 2000  --> Loss function: 0.0010892425721901855\n","Iteration: 2100  --> Loss function: 0.0010620792862296269\n","Iteration: 2200  --> Loss function: 0.000940370924507584\n","Iteration: 2300  --> Loss function: 0.000891576222778463\n","Iteration: 2400  --> Loss function: 0.00082104114330834577\n","Iteration: 2500  --> Loss function: 0.00068236196542697538\n","Iteration: 2600  --> Loss function: 0.00055635480861007333\n","Iteration: 2700  --> Loss function: 0.00048482282456546841\n","Iteration: 2800  --> Loss function: 0.00039421063661737018\n","Iteration: 2900  --> Loss function: 0.00033645304223899172\n","Iteration: 3000  --> Loss function: 0.00031059412392845455\n","Iteration: 3100  --> Loss function: 0.00029448720699198482\n","Iteration: 3200  --> Loss function: 0.000277615047819109\n","Iteration: 3300  --> Loss function: 0.00023706511458435392\n","Iteration: 3400  --> Loss function: 0.00018523603244650631\n","Iteration: 3500  --> Loss function: 0.00017445569939615244\n","Iteration: 3600  --> Loss function: 0.00016413800078748442\n","Iteration: 3700  --> Loss function: 0.00016152284692061531\n","Iteration: 3800  --> Loss function: 0.00015363035731369697\n","Iteration: 3900  --> Loss function: 0.00014362444131970205\n","Iteration: 4000  --> Loss function: 0.00012313132608192298\n","Iteration: 4100  --> Loss function: 0.0001185924058716947\n","Iteration: 4200  --> Loss function: 0.00011443959060834074\n","Iteration: 4300  --> Loss function: 0.0001032395850230228\n","Iteration: 4400  --> Loss function: 8.8722694543321532e-05\n","Iteration: 4500  --> Loss function: 8.6642305372295879e-05\n","Iteration: 4600  --> Loss function: 8.4508284159401465e-05\n","Iteration: 4700  --> Loss function: 8.20629236142172e-05\n","Iteration: 4800  --> Loss function: 8.0888110841058827e-05\n","Iteration: 4900  --> Loss function: 7.2241333455238114e-05\n","Iteration: 5000  --> Loss function: 6.97103231792893e-05\n","Iteration: 5100  --> Loss function: 6.92634453395054e-05\n","Iteration: 5200  --> Loss function: 5.7515008454726937e-05\n","Iteration: 5300  --> Loss function: 5.4107482465455393e-05\n","Iteration: 5400  --> Loss function: 5.3744055020434666e-05\n","Iteration: 5500  --> Loss function: 5.33503665974722e-05\n","Iteration: 5600  --> Loss function: 4.5272321679331355e-05\n","Iteration: 5700  --> Loss function: 3.9655507884153467e-05\n","Iteration: 5800  --> Loss function: 3.905181054893849e-05\n","Iteration: 5900  --> Loss function: 3.7898704505540157e-05\n","Iteration: 6000  --> Loss function: 3.70977058756372e-05\n","Iteration: 6100  --> Loss function: 3.648389431436638e-05\n","Iteration: 6200  --> Loss function: 3.5944751143050252e-05\n","Iteration: 6300  --> Loss function: 3.3698804763795624e-05\n","Iteration: 6400  --> Loss function: 3.0905666950041252e-05\n","Iteration: 6500  --> Loss function: 2.8925262672078683e-05\n","Iteration: 6600  --> Loss function: 2.8495734395439149e-05\n","Iteration: 6700  --> Loss function: 2.8051458989909508e-05\n","Iteration: 6800  --> Loss function: 2.5735989516781122e-05\n","Iteration: 6900  --> Loss function: 2.530772099537919e-05\n","Iteration: 7000  --> Loss function: 2.2573466821594824e-05\n","Iteration: 7100  --> Loss function: 1.9456216498775716e-05\n","Iteration: 7200  --> Loss function: 1.9258652052005026e-05\n","Iteration: 7300  --> Loss function: 1.894369101075585e-05\n","Iteration: 7400  --> Loss function: 1.8664125378657332e-05\n","Iteration: 7500  --> Loss function: 1.8547102943341663e-05\n","Iteration: 7600  --> Loss function: 1.8521940498671307e-05\n","Iteration: 7700  --> Loss function: 1.8453807792166546e-05\n","Iteration: 7800  --> Loss function: 1.8203019551386008e-05\n","Training finished with Loss = 1.8161825576967566e-05\n","Runtime: 597.5958 seconds\n"]}],"source":["seed = 1234\n","np.random.seed(seed)\n","tf.keras.utils.set_random_seed(seed)\n","\n","# Data generation\n","G = tensor(0.75)\n","a=0.5\n","#N_data_pts = 100\n","\n","def solution(xyt):\n","    x = xyt[:, 0:1]\n","    y = xyt[:, 1:2]\n","    t = xyt[:, 2:3]\n","    return  t**2*tf.exp(x+y)\n","\n","\n","\n","def forcing_elliptic(xyt):\n","    x = xyt[:, 0:1]\n","    y = xyt[:, 1:2]\n","    t = xyt[:, 2:3]\n","    return (2*t**(2-a)/gamma(3-a) - 2*G*t**2)*tf.exp(x+y)\n","\n","#x_data = tensor(x_data)\n","#u_data = solution(x_data)\n","\n","\n","\n","\n","N_x=4\n","N_y=4\n","N_t=13\n","x = np.random.uniform(low=[0.0], high=[1.0], size=(N_x,1))\n","y = np.random.uniform(low=[0.0], high=[1.0], size=(N_y,1))\n","t= np.linspace(0, 1 ,N_t)\n","t1=t[1]\n","x,y,t=np.meshgrid(x,y,t[1:])\n","N_t=N_t-1\n","xyt = np.concatenate([x.reshape(N_x*N_y*N_t, 1),y.reshape(N_x*N_y*N_t, 1), t.reshape(N_x*N_y*N_t, 1)], axis=1)\n","x_eq=tensor(xyt)\n","f_eq = forcing_elliptic(x_eq)\n","\n","\n","# Neural network creation\n","lambdas_eq_data_dirichlet = [8, 30, 5]\n","nn = NeuralNetwork(input_dim = 3, n_layers = 3, n_neurons = 20, activ_fun = 'tanh', lambdas_eq_data_dirichlet = lambdas_eq_data_dirichlet)\n","\n","nn.N_x=N_x\n","nn.N_y=N_y\n","nn.N_t=N_t\n","nn.a=a\n","nn.t1=t1\n","# Boundary conditions\n","N_bc_pts = 40\n","t_start, t_end = 0.0, 1.0\n","\n","t = np.linspace(t_start, t_end, 50)\n","x = np.linspace(0.0, 1.0, N_bc_pts)\n","\n","X, T = np.meshgrid(x, t, indexing='ij')\n","\n","dirichlet_pts_bot =tensor( np.column_stack([X.ravel(), np.full_like(X.ravel(), 0.0), T.ravel()]))\n","dirichlet_pts_up = tensor(np.column_stack([X.ravel(), np.full_like(X.ravel(), 1.0), T.ravel()]))\n","dirichlet_pts_left =tensor( np.column_stack([ np.full_like(X.ravel(), 1.0),X.ravel(), T.ravel()]))\n","dirichlet_pts_right = tensor(np.column_stack([ np.full_like(X.ravel(), 0.0),X.ravel(), T.ravel()]))\n","\n","x_dirichlet = tf.concat([dirichlet_pts_bot, dirichlet_pts_up, dirichlet_pts_left, dirichlet_pts_right], axis=0)\n","nn.x_dirichlet = x_dirichlet\n","nn.u_dirichlet = solution(x_dirichlet)\n","\n","#nn.phi, nn.lifting = nn.adapt_bc()\n","t_start, t_end = 0.0, 1.0\n","\n","y = np.linspace(0.0, 1.0, 5)\n","x = np.linspace(0.0, 1.0, 5)\n","\n","X, Y = np.meshgrid(x, y, indexing='ij')\n","\n","x_data= tensor( np.column_stack([X.ravel(), Y.ravel(), np.full_like(X.ravel(), 1.0)]))\n","x_data = tensor(x_data)\n","u_data = solution(x_data)\n","nn.u_data=u_data\n","nn.x_data=x_data\n","\n","used_loss = nn.pinn_loss\n","\n","# Training\n","n_epochs_adam = 10\n","n_steps_bfgs = 3000\n","\n","#train_with_first_order(nn, used_loss, x_eq, f_eq, n_epochs_adam, True, learning_rate=1e-2, verbose=1)\n","build_nn(nn, (None, nn.input_dim))\n","start = time.time()\n","optimizer_outputs = train_w_bfgs(nn, used_loss, x_eq, f_eq, n_steps_bfgs, bfgs=True, tolerance=1e-7)\n","end = time.time()\n","print(f\"Runtime: {end - start:.4f} seconds\")"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"Qi22q5x5wyfo","colab":{"base_uri":"https://localhost:8080/","height":964},"executionInfo":{"status":"ok","timestamp":1742476100912,"user_tz":-330,"elapsed":6858,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}},"outputId":"59f04c3b-21ff-4cf4-f0b2-01383ad07591"},"outputs":[{"output_type":"stream","name":"stderr","text":["WARNING:matplotlib.backends.backend_ps:The PostScript backend does not support transparency; partially transparent artists will be rendered opaque.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stderr","text":["WARNING:matplotlib.backends.backend_ps:The PostScript backend does not support transparency; partially transparent artists will be rendered opaque.\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["visualize_2d_time_sol(nn, solution, 0.1)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"8OQ-JgENw1pg","colab":{"base_uri":"https://localhost:8080/","height":296},"executionInfo":{"status":"ok","timestamp":1742476102023,"user_tz":-330,"elapsed":1085,"user":{"displayName":"Vighnesh Vinod Alavani","userId":"05850555216708142856"}},"outputId":"8a8a9ebf-c06e-4221-ccd5-d58d4268c0f2"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1100x300 with 6 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["visualize_contour_sol(nn,solution,1.0)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"YetGankO-mJv","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1742476103477,"user_tz":-330,"elapsed":1452,"u